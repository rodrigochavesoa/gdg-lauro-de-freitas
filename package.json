{
  "name": "gdgjobs-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:bundle": "node scripts/check-bundle-secrets.mjs",
    "migrations:prod": "node scripts/prod-migrations.mjs",
    "migrations:homolog": "node scripts/prod-migrations.mjs --homolog-chain",
    "migrations:homolog:apply": "node scripts/prod-migrations.mjs --apply",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "node scripts/check-rls.mjs",
    "verify:staff-mfa": "node scripts/verify-staff-mfa-probe.mjs",
    "qa:a11y": "node scripts/qa-a11y.mjs",
    "qa:admin-nav": "node scripts/measure-admin-nav.mjs",
    "qa:job-detail": "node scripts/measure-job-detail.mjs",
    "qa:my-applications": "node scripts/measure-my-applications.mjs",
    "qa:perf-avatar-01": "node scripts/measure-perf-avatar-01.mjs",
    "qa:staff-lists": "node scripts/measure-staff-lists.mjs",
    "clickup:bootstrap": "node scripts/bootstrap-clickup.mjs",
    "clickup:sprint-handoff": "node scripts/sprint-handoff-clickup.mjs",
    "clickup:sync": "node scripts/bootstrap-clickup.mjs && node scripts/sprint-handoff-clickup.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "^7.18.2",
    "vite": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "eslint": "9.39.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "playwright": "1.63.0",
    "vitest": "3.2.4"
  }
}
